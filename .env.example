# AI provider API key. Keep it server-side.
AI_API_KEY=

# Optional model override. Leave empty to use the app default.
AI_MODEL=

# Optional comma-separated fallback models used when the primary model is overloaded.
AI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash

# DeepSeek provider support.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4
DEEPSEEK_FALLBACK_MODELS=deepseek-chat,deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
